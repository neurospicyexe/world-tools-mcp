# Port to listen on (bound to 127.0.0.1; Cloudflare Tunnel handles TLS)
PORT=3456

# Bearer token — pick any strong secret; set the same value in Claude.ai when adding the MCP
API_KEY=your-secret-here

# Public URL the tunnel exposes (no trailing slash)
PUBLIC_URL=https://world.example.com

# Default lat/lon for weather (decimal degrees)
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
